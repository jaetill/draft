{
  "name": "draft",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run build-players && npm run build-rankings && npm run build-byes",
    "build": "vite build",
    "preview": "vite preview",
    "probe": "node scripts/probe.js",
    "build-players": "node scripts/build-players.mjs",
    "build-rankings": "node scripts/build-rankings.mjs",
    "build-byes": "node scripts/build-byes.mjs",
    "build-tiers": "node scripts/build-tiers.mjs",
    "build-tendencies": "node scripts/build-tendencies.mjs",
    "build-value-curve": "node scripts/build-value-curve.mjs",
    "export-board": "node scripts/export-board.mjs",
    "market-gap": "node scripts/market-gap.mjs",
    "watch-draft": "node scripts/watch-draft.mjs",
    "refresh-data": "npm run build-players && npm run build-rankings && npm run build-byes && npm run build-value-curve && npm run build-tiers && npm run export-board",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.13.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.13.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-promise": "^7.1.0",
    "eslint-plugin-unused-imports": "^4.1.0",
    "globals": "^15.11.0",
    "happy-dom": "^14.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "vite": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@sentry/browser": "^10.53.1"
  }
}
